@page "/plugins/adjustments/local.sequentialautoshift"
@using ETS2LA.UI.Shared.Components
@implements IDisposable

<div class="flex flex-col w-108 m-5 ml-8 gap-6">
    <Separator Label="Sequential Auto Shift" />
    <p class="description">Shifts a sequential gearbox from a throttle-interpolated shift schedule, checked against the gear ratios before a pulse is sent.</p>

    @if (Plugin is null)
    {
        <p class="description">Plugin is not loaded.</p>
    }
    else
    {
        <Switch Title="Enabled"
                Description="Automatically sends sequential gear-up and gear-down pulses."
                Value="@Plugin.Settings.Enabled"
                ValueChanged="@((bool value) => Plugin.HandleAction("enabled", value))" />
        <Switch Title="Downshift"
                Description="Allows the plugin to downshift when RPM falls below the downshift line."
                Value="@Plugin.Settings.DownshiftEnabled"
                ValueChanged="@((bool value) => Plugin.HandleAction("downshiftEnabled", value))" />
        <Switch Title="Coast downshift"
                Description="Keep downshifting while the throttle is lifted or the brakes are applied, so the engine keeps braking. Upshifts stay blocked during braking."
                Value="@Plugin.Settings.CoastDownshiftEnabled"
                ValueChanged="@((bool value) => Plugin.HandleAction("coastDownshiftEnabled", value))" />
        <Switch Title="Adapt to load and gradient"
                Description="Raise both shift lines when the truck demands throttle but does not accelerate, or when it is heavily loaded."
                Value="@Plugin.Settings.AdaptiveShiftPoints"
                ValueChanged="@((bool value) => Plugin.HandleAction("adaptiveShiftPoints", value))" />
        <Switch Title="Start engine with ACC"
                Description="When ACC is active and telemetry reports the engine off, sends an ignition and crank pulse."
                Value="@Plugin.Settings.StartEngineWhenAccActive"
                ValueChanged="@((bool value) => Plugin.HandleAction("startEngineWhenAccActive", value))" />
        <Switch Title="Reset gear when stopped"
                Description="After the truck has been stopped for the dwell time, downshift toward the selected start gear."
                Value="@Plugin.Settings.ResetGearWhenStopped"
                ValueChanged="@((bool value) => Plugin.HandleAction("resetGearWhenStopped", value))" />

        <Separator Label="Shift schedule" />
        <p class="description">The lines are interpolated across throttle travel, so the low values apply when coasting and the high values at full throttle.</p>
        <Slider Title="Upshift RPM (no throttle)" Suffix="rpm"
                Description="Engine speed to reach before an upshift with the throttle closed. Never above 97% of the truck's redline."
                Min="900" Max="@Plugin.UpshiftRpmSliderMax" Step="50"
                Value="@Plugin.UpshiftRpmSliderValue"
                ValueChanged="@((float value) => Plugin.HandleAction("upshiftRpm", value))" />
        <Slider Title="Upshift RPM (full throttle)" Suffix="rpm"
                Description="Engine speed to reach before an upshift at full throttle. Never above 97% of the truck's redline."
                Min="900" Max="@Plugin.UpshiftRpmSliderMax" Step="50"
                Value="@Plugin.UpshiftFullThrottleSliderValue"
                ValueChanged="@((float value) => Plugin.HandleAction("upshiftRpmFullThrottle", value))" />
        <Slider Title="Downshift RPM (no throttle)" Suffix="rpm"
                Description="Engine speed that triggers a downshift with the throttle closed."
                Min="500" Max="@Plugin.UpshiftRpmSliderMax" Step="50"
                Value="@(Convert.ToSingle(Plugin.Settings.DownshiftRpm))"
                ValueChanged="@((float value) => Plugin.HandleAction("downshiftRpm", value))" />
        <Slider Title="Kickdown RPM (full throttle)" Suffix="rpm"
                Description="Engine speed that triggers a downshift at full throttle for maximum pull."
                Min="500" Max="@Plugin.UpshiftRpmSliderMax" Step="50"
                Value="@(Convert.ToSingle(Plugin.Settings.KickdownRpm))"
                ValueChanged="@((float value) => Plugin.HandleAction("kickdownRpm", value))" />
        <Slider Title="Landing margin" Suffix="rpm"
                Description="An upshift is skipped unless the gear ratios say the engine will land this much above the downshift line. This is what stops 1-2-1 hunting."
                Min="100" Max="800" Step="25"
                Value="@(Convert.ToSingle(Plugin.Settings.ShiftHysteresisRpm))"
                ValueChanged="@((float value) => Plugin.HandleAction("shiftHysteresisRpm", value))" />
        <Slider Title="Start gear"
                Description="Lowest gear the plugin will downshift into, and the gear it resets to when stopped."
                Min="1" Max="6" Step="1"
                Value="@Plugin.Settings.StartGear"
                ValueChanged="@((float value) => Plugin.HandleAction("startGear", value))" />

        <Separator Label="Timing" />
        <Slider Title="Minimum time in gear (ms)"
                Description="Wait after a confirmed shift before another one may be requested."
                Min="250" Max="2000" Step="50"
                Value="@(Convert.ToSingle(Plugin.Settings.ShiftCooldownMs))"
                ValueChanged="@((float value) => Plugin.HandleAction("shiftCooldownMs", value))" />
        <Slider Title="Manual takeover pause (ms)"
                Description="How long shifting waits after the clutch is pressed or a gear change the plugin did not request is seen. Braking only blocks upshifts."
                Min="0" Max="5000" Step="100"
                Value="@(Convert.ToSingle(Plugin.Settings.ManualPauseMs))"
                ValueChanged="@((float value) => Plugin.HandleAction("manualPauseMs", value))" />
        <Slider Title="Stop dwell (ms)"
                Description="How long the truck must stay under the stopped speed before its gear is reset."
                Min="0" Max="5000" Step="100"
                Value="@(Convert.ToSingle(Plugin.Settings.StopDwellMs))"
                ValueChanged="@((float value) => Plugin.HandleAction("stopDwellMs", value))" />
        <Slider Title="Engine start retry (ms)"
                Description="Minimum wait between engine start pulses while ACC remains active."
                Min="1000" Max="10000" Step="500"
                Value="@(Convert.ToSingle(Plugin.Settings.EngineStartRetryMs))"
                ValueChanged="@((float value) => Plugin.HandleAction("engineStartRetryMs", value))" />

        <Separator Label="Input thresholds" />
        <Slider Title="@($"Minimum upshift speed ({SpeedLabel})")" Suffix="@SpeedLabel"
                Description="Below this speed no upshift is requested. Downshifts stay available so a slow truck can find a lower gear."
                Min="0" Max="@MaxUpshiftSpeed" Step="1"
                Value="@MinimumUpshiftSpeed"
                ValueChanged="@((float value) => Plugin.HandleAction("minimumSpeedKph", value))" />
        <Slider Title="@($"Stopped speed ({SpeedLabel})")" Suffix="@SpeedLabel"
                Description="At or below this speed the truck counts as stopped for the gear reset."
                Min="0" Max="@MaxStoppedSpeed" Step="@(0.1f)"
                Value="@StoppedSpeed"
                ValueChanged="@((float value) => Plugin.HandleAction("stoppedSpeedKph", value))" />
        <Slider Title="Brake threshold"
                Description="Brake travel (0-1) that counts as the driver braking."
                Min="@(0.01f)" Max="1" Step="@(0.01f)"
                Value="@(Convert.ToSingle(Plugin.Settings.BrakeThreshold))"
                ValueChanged="@((float value) => Plugin.HandleAction("brakeThreshold", value))" />
        <Slider Title="Clutch threshold"
                Description="Clutch travel (0-1) that counts as the driver taking over the gearbox."
                Min="@(0.01f)" Max="1" Step="@(0.01f)"
                Value="@(Convert.ToSingle(Plugin.Settings.ClutchThreshold))"
                ValueChanged="@((float value) => Plugin.HandleAction("clutchThreshold", value))" />

        <Separator Label="Status" Class="mt-4" />
        <div class="flex flex-col rounded-sm bg-control-bg-dark border border-bg-darker p-4 gap-2">
            @foreach (var row in Plugin.StatusRows)
            {
                <div class="flex justify-between gap-4">
                    <p class="text-description">@row.Key</p>
                    <p>@row.Value</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private SequentialAutoShiftPlugin? Plugin => SequentialAutoShiftPlugin.Instance;

    private string SpeedLabel => SequentialAutoShiftPlugin.SpeedUnitLabel;
    private float MaxUpshiftSpeed => SequentialAutoShiftPlugin.SpeedFromKmh(25);
    private float MaxStoppedSpeed => SequentialAutoShiftPlugin.SpeedFromKmh(5);
    private float MinimumUpshiftSpeed => Plugin is null ? 0 : SequentialAutoShiftPlugin.SpeedFromKmh(Plugin.Settings.MinimumSpeedKph);
    private float StoppedSpeed => Plugin is null ? 0 : SequentialAutoShiftPlugin.SpeedFromKmh(Plugin.Settings.StoppedSpeedKph);

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _cts = new CancellationTokenSource();
        _ = RefreshLoop(_cts.Token);
    }

    private async Task RefreshLoop(CancellationToken token)
    {
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await _timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
